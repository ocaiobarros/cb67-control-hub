# CB67 Labs Control Center — example environment
#
# Copy to .env for local development. NEVER commit a real .env: this repository
# is public and Vite inlines every VITE_* value into the browser bundle at build
# time, so a committed value is a published value.
#
# No secret belongs in any variable here. Provider credentials (OpenAI, Gemini,
# Maps) terminate at the platform broker and never reach the browser.

# Serve deterministic mock data instead of calling a backend.
# Mock data is OPT-IN and defaults to FALSE. Set it to true only for local work
# without a backend. Anything that has not explicitly asked for mocks gets the
# real API, so a forgotten variable can never ship fabricated figures.
VITE_USE_MOCK_API=true

# Management API base URL. Required when VITE_USE_MOCK_API=false.
VITE_CB67_API_BASE_URL=

# Licensing service base URL, when served separately from the management API.
VITE_CB67_LICENSE_BASE_URL=

# Public status feed base URL.
VITE_CB67_STATUS_BASE_URL=

# production | staging | development — drives the environment badge.
VITE_CB67_ENVIRONMENT=development

# Frontend telemetry. Enable only when the backend accepts it.
VITE_CB67_TELEMETRY_ENABLED=false

# Observability deep-links. Management network only — these are never reachable
# from the public internet. Grafana is not deployed (D-010); the observability
# surface is fed by Prometheus and Alertmanager (D-018).
VITE_PROMETHEUS_URL=
VITE_ALERTMANAGER_URL=
